<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- CAMERA: bắt buộc khi dùng camera plugin -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Thiết bị có thể có bất kỳ camera nào; không bắt buộc phần cứng -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!-- Quyền internet (load ảnh demo, v.v.) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Quyền đọc ảnh:
         - Android 13+ (API 33+): READ_MEDIA_IMAGES
         - Android 12 trở xuống: READ_EXTERNAL_STORAGE (tối đa 32)
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Ghi external storage CHỈ cho Android 9 trở xuống (tối đa API 28).
         Tránh vi phạm policy trên Android mới. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name="${applicationName}"
        android:label="security_camera"
        android:icon="@mipmap/ic_launcher">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode">

            <!-- Theme hiển thị trong lúc Flutter khởi tạo -->
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Flutter plugin registry -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Package visibility: cho ProcessTextPlugin của Flutter engine -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
